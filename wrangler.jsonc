{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bu-proto",
  // Andres's Cloudflare account: the login sees several, so Wrangler needs to be told which.
  "account_id": "0bda3a2560ca48711ef7336cc421abed",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,

  // The site lives at buproto.com (its DNS is on Cloudflare). Kept here so a deploy never drops it.
  "routes": [{ "pattern": "buproto.com", "custom_domain": true }],
  // No <name>.workers.dev address for production, but keep Preview URLs on: every deploy applies
  // these, and left unset they drift off, which leaves branch previews without a link.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },

  // The site is the Vite build. Every unknown path serves index.html for the client router;
  // only /api/* reaches the Worker.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /privacy and /terms also reach the Worker, which renders their text into the HTML for crawlers.
    "run_worker_first": ["/api/*", "/privacy", "/terms"]
  },

  // The production database. Local dev uses its own copy in .wrangler/state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bu-proto",
      "database_id": "2280c64d-5b92-48a2-a5ad-47a1fbaf14cd",
      "migrations_dir": "./migrations"
    }
  ],

  // Public forms (join, fund interest, RSVP): 10 submissions per minute per IP.
  "ratelimits": [
    {
      "name": "FORM_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // Daily at 09:17 UTC (4–5 AM in Boston): import upcoming hackathons from MLH and Devpost into
  // the portal's review queue.
  "triggers": { "crons": ["17 9 * * *"] },

  // Branch previews (`wrangler preview`, run by Workers Builds on every non-main push). They get
  // their own database, so a preview never reads or writes production. Its tables come from the
  // same migrations: `npx wrangler d1 migrations apply bu-proto-preview --remote`. Previews have
  // no RESEND_API_KEY, so their emails are logged, not sent.
  "previews": {
    "vars": {
      "EMAIL_FROM": "BU Proto Preview <hello@buproto.com>",
      "EMAIL_REPLY_TO": ""
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "bu-proto-preview",
        "database_id": "816fbdec-b000-4fc0-8647-afbf19a1266a",
        "migrations_dir": "./migrations"
      }
    ],
    "ratelimits": [
      {
        "name": "FORM_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },

  "vars": {
    // Sender for every email. buproto.com has to be verified in Resend before this sends.
    "EMAIL_FROM": "BU Proto <hello@buproto.com>",
    // Optional reply-to address for every email.
    "EMAIL_REPLY_TO": ""
  }

  // Secrets: `wrangler secret put <NAME>` in production, .dev.vars locally (see .dev.vars.example).
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET   the Google OAuth client (Web application)
  //   ADMIN_EMAILS                             owners: always admins, can't be removed in the
  //                                            portal. Comma-separated; a secret so personal
  //                                            emails stay out of this public repo
  //   RESEND_API_KEY                           leave unset locally to log emails instead of sending
  //   TURNSTILE_SECRET_KEY                     the buproto.com widget's secret; empty locally uses the test key
}
