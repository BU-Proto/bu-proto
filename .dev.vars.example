# Copy to .dev.vars for local development (it's gitignored).
# Google OAuth client (Web application) with redirect URI http://localhost:5173/api/auth/callback.
# Under `npm run dev` the sign-in button skips Google and signs you in locally, so these can stay
# empty unless you're testing the real flow (that needs a production-like build, see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Owners, comma-separated emails. Local sign-in uses the first, or you@localhost when empty.
ADMIN_EMAILS=
# Leave empty to log emails to the dev server console instead of sending them.
RESEND_API_KEY=

# Cloudflare Turnstile secret for the public forms. Leave empty: `vite dev` then uses Cloudflare's
# always-pass test secret. Production reads it from the Worker secret (see README).
TURNSTILE_SECRET_KEY=
